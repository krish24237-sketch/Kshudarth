# Store text with LF line endings everywhere (Vercel builds on Linux).
* text=auto eol=lf

# Never touch line endings in binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.mp4   binary
*.mov   binary
*.webm  binary
*.woff  binary
*.woff2 binary
